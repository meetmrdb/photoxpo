  "narrative": {
    "northStar": "The Quiet Shelf",
    "overview": "A shelf in a quiet room: everything has a place, you can see at a glance that it is all there, and nothing asks for attention until you reach for it. Native Material 3 in a single teal voice, with large pill buttons, soft tonal surfaces and plain words.",
    "keyCharacteristics": [
      "Native Material 3 structure, single teal brand hue",
      "Tonal layering instead of shadows",
      "Pill buttons 56 dp tall; every target at least 48 dp",
      "Large type, 16 sp body minimum",
      "Status never by colour alone",
      "Dark theme is a full scheme; the photo viewer is always dark"
    ],
    "rules": [
      {
        "name": "The Calm Drive Rule",
        "body": "A missing Archive Drive is amber or neutral, never red. Red means a file did not verify or a copy failed.",
        "section": "colors"
      },
      {
        "name": "The One Voice Rule",
        "body": "Teal is the only brand hue. Primary teal fills at most one button per screen.",
        "section": "colors"
      },
      {
        "name": "The Words Beside Colour Rule",
        "body": "A state is never signalled by colour alone; every chip, badge and pill carries an icon and a plain-word label.",
        "section": "colors"
      },
      {
        "name": "The Sentence First Rule",
        "body": "Each screen opens with one complete plain sentence as its headline.",
        "section": "typography"
      },
      {
        "name": "The Flat Chrome Rule",
        "body": "App chrome has no shadows. Only the photo viewer uses gradients, and only to keep text legible.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do open every screen with one plain sentence, one count and one obvious button.",
      "Do say where the Original is in plain words, beside an icon.",
      "Do keep 48 dp minimum targets and 56 dp for the primary action.",
      "Do theme through Material roles; never raw hex in a composable.",
      "Do treat a missing drive as a calm, ordinary state.",
      "Do let the photo viewer go fully dark.",
      "Do honour Reduce Motion."
    ],
    "donts": [
      "Don't use the stock Material purple baseline or a second brand hue.",
      "Don't use red for a missing drive, or teal for an unverified state.",
      "Don't show a full progress bar at rest, or repeat a count twice on one screen.",
      "Don't use the words cloud, thumbnail, synced, or restore.",
      "Don't put shadows on app chrome or nest cards.",
      "Don't hide the where-is-it message inside a sheet.",
      "Don't stretch the phone layout on wide windows."
    ]
  }
